# Copy this file to `.env` and fill in both values. NEVER commit the real .env.
#
# Your Tradier PRODUCTION access token (sandbox tokens can't stream). Every visitor's
# market data is served under this one token — that's the shared-token model you chose.
TRADIER_TOKEN=your-tradier-production-token-here

# The Cloudflare Tunnel token from the Zero Trust dashboard
# (Networks -> Tunnels -> your tunnel -> Install connector -> the long token in the
#  `cloudflared ... run <TOKEN>` command). See DEPLOY.md step 3.
TUNNEL_TOKEN=your-cloudflare-tunnel-token-here
